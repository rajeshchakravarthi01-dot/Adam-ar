{
  "manifest_version": 3,
  "name": "AdamBee — AuditEQ Ticket & Screen Compliance Auditor",
  "version": "2.0.0",
  "description": "Autonomous CRM and ticket capture extension for SEBI regulatory compliance and quality audits.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdamBee Ticket Auditor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
