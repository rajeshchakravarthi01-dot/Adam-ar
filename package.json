    "adm-zip": "^0.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.6",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
